void main() {
  double n1 = 9.8;
  double n2 = 3.0;
  String operador = "+";

  if (operador == "+") {
    print("Resultado: ${n1 + n2}");
  } else if (operador == "-") {
    print("Resultado: ${n1 - n2}");
  } else if (operador == "*") {
    print("Resultado: ${n1 * n2}");
  } else if (operador == "/") {
    if (n2 != 0) {
      print("Resultado: ${n1 / n2}");
    } else {
      print("Não é possível dividir por zero");
    }
  } else {
    print("Operador inválido");
  }
}
