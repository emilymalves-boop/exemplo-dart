class Produto {
  String nome;
  double preco;
  int quantidade;

  Produto(this.nome, this.preco, this.quantidade);

  double valorEmEstoque() {
    return preco * quantidade;
  }
}

void main() {
  List<Produto> produtos = [
    Produto("Caderno", 25.0, 4),
    Produto("Caneta", 3.0, 10),
    Produto("Mochila", 120.0, 2),
  ];

  double total = 0;

  for (Produto produto in produtos) {
    total = total + produto.valorEmEstoque();
  }

  print("Total em estoque: $total");
}
