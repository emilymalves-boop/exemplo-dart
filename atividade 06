class ContaBancaria {
  String titular;
  double saldo;

  ContaBancaria(this.titular, this.saldo);

  void depositar(double valor) {
    saldo = saldo + valor;
  }

  void sacar(double valor) {
    if (valor > saldo) {
      print("Saldo insuficiente");
    } else {
      saldo = saldo - valor;
    }
  }

  void mostrarSaldo() {
    print("Saldo de $titular: R\$ $saldo");
  }
}

void main() {
  ContaBancaria conta = ContaBancaria("Amelie", 100.0);

  conta.depositar(50);
  conta.sacar(30);
  conta.sacar(500);

  conta.mostrarSaldo();
}
