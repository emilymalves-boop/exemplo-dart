void apresentar() {
  print("Olá, meu nome é Isabela e estou aprendendo Flutter!");
}

void saudar(String nome) {
  print("Bom dia, $nome!");
}

int dobro(int numero) {
  return numero * 2;
}

double media(double n1, double n2) {
  return (n1 + n2) / 2;
}

String situacao(double nota) {
  if (nota >= 7) {
    return "Aprovado";
  } else {
    return "Reprovado";
  }
}

int somarLista(List<int> numeros) {
  int soma = 0;

  for (int numero in numeros) {
    soma += numero;
  }

  return soma;
}

void main() {
  //1- apresentar
  apresentar();
  apresentar();
  apresentar();

  // 2- Saudar
  saudar("luana");
  saudar("mariane");
  saudar("luan");

  // 3- Dobro
  print(dobro(5));
  print(dobro(21));

  // 4- Média e situação
  double media1 = media(8, 6);
  print("Média: $media1");
  print(situacao(media1));

  double media2 = media(5, 6);
  print("Média: $media2");
  print(situacao(media2));

  // 5- Somar lista
  print(somarLista([3, 7, 10]));
}
